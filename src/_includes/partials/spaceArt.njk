{%- if sectionArt == "planet" %}
<svg class="gh-art gh-art-planet" viewBox="0 0 400 400" aria-hidden="true">
<g transform="translate(200 200) rotate(-18)">
<ellipse rx="185" ry="48" fill="none" stroke="#6f8bd8" stroke-opacity=".4" stroke-width="12"/>
<circle r="100" fill="#26307a"/><circle r="100" fill="none" stroke="#6f8bd8" stroke-width="1.5"/>
<path d="M-96-28Q0-48 96-28M-100 8Q0-12 100 8M-88 46Q0 28 88 46" fill="none" stroke="#6f8bd8" stroke-opacity=".5" stroke-width="7"/>
<path d="M-185 0A185 48 0 0 0 185 0" fill="none" stroke="#a9bcf0" stroke-width="12"/>
</g>
</svg>
{%- elif sectionArt == "orbits" %}
<svg class="gh-art gh-art-orbits" viewBox="0 0 600 600" aria-hidden="true">
<g fill="none" stroke="#ffffff" stroke-opacity=".16"><circle cx="300" cy="300" r="120"/><circle cx="300" cy="300" r="200"/><circle cx="300" cy="300" r="285" stroke-dasharray="3 9"/></g>
<circle cx="300" cy="300" r="36" fill="#ff9a4d"/>
