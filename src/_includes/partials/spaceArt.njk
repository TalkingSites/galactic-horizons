<g class="gh-orbit gh-orbit-b"><circle cx="100" cy="300" r="11" fill="#a9bcf0"/></g>
</svg>
{%- elif sectionArt == "stars" %}
<svg class="gh-art gh-art-stars" viewBox="0 0 420 240" aria-hidden="true">
