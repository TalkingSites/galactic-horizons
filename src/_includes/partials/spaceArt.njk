<g fill="#b93a0b"><circle cx="20" cy="170" r="4"/><circle cx="100" cy="90" r="6"/><circle cx="190" cy="130" r="4"/><circle cx="270" cy="40" r="7"/><circle cx="400" cy="80" r="4"/><circle cx="240" cy="210" r="5"/></g>
</svg>
{%- elif sectionArt == "moon" %}
<svg class="gh-art gh-art-moon" viewBox="0 0 640 640" aria-hidden="true">
<defs><radialGradient id="gh-moon" cx="35%" cy="30%" r="85%"><stop offset="0" stop-color="#f3eee2"/><stop offset=".55" stop-color="#a7a2bb"/><stop offset="1" stop-color="#2c2a48"/></radialGradient></defs>
